--- !u!114 &1253946932346020393
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4623696515224243716}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0cc32927417fbf141bdb7985a1e5a1a7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 0}
  talkPromptText: {fileID: 0}
  testCost: 20
  greetingLines:
  - "So Tev sent you to learn to fly. Good \u2014 better the drones take the knocks
    than a real hull."
  briefingLines:
  - "Here's the drill. You put on the goggles and fly a scaled-down replica \u2014
    flies exactly like the real ship, same stick."
  - Take off, fly one full lap around Humble Abode, and set down back on the pad.
    Do that clean and you've earned your licence.
  - "Lose your nerve? Tap F twice to pull the goggles off \u2014 but that's a fail.
    Fly into the ground, same thing. It's $20 a go, so fly smart."
  enterTestLines:
  - Goggles on. Let's see what you've got.
  cantAffordLines:
  - Test's $20. Come back when your pockets aren't so light.
  licensedLines:
  - Ha! You already passed. Cleared to fly the real thing.
  - "Go on \u2014 take your ship up and make for Constant Companion. Tev'll meet
    you on the far side of it."
  charDelay: 0.03
  typewriterLoopClip: {fileID: 0}
  typewriterVolume: 0.3
