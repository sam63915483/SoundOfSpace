  m_Name: 
  m_EditorClassIdentifier: 
  talkPromptText: {fileID: 0}
  greetingText: {fileID: 0}
  sellPanel: {fileID: 0}
  greetingMessage: Welcome to my humble shop traveller!
  charDelay: 0.03
  typewriterLoopClip: {fileID: 8300000, guid: eea9ebed7c1aabb43bcb4de0f049ca8e, type: 3}
  typewriterVolume: 0.3
  saleClip: {fileID: 8300000, guid: 79da6817f5e8c46418004ae0385623b9, type: 3}
  saleVolume: 0.7
  earningsDisplayDuration: 3
  earningsFadeDuration: 0.5
  sellButton: {fileID: 0}
  earningsText: {fileID: 0}
  commonInfoText: {fileID: 0}
  uncommonInfoText: {fileID: 0}
  rareInfoText: {fileID: 0}
  commonStagedText: {fileID: 0}
  uncommonStagedText: {fileID: 0}
  rareStagedText: {fileID: 0}
  panelTotalText: {fileID: 0}
  commonPlusButton: {fileID: 0}
  uncommonPlusButton: {fileID: 0}
  rarePlusButton: {fileID: 0}
  browseFishButton: {fileID: 0}
  fishingRodController: {fileID: 0}
  bountyStoryLines:
  - The bounty fish? Sit down. Well -- stand there, but quietly.
  - Years back a kid was playing on the north shore of the lake. Big splash, little
    scream, and the water went flat like nothing happened. They found one shoe. Wet.
  - GRULABU, the old-timers call it. Red as a warning light, long as a shuttle, and
    it does not lose.
  - Bring me that fish, whole, and I pay five hundred. Not for the meat. For the
    peace of mind.
  bountyDoneLines:
  - The GRULABU is gone. The lake is quieter. I sleep now. You did that.
  bountyTurnInLines:
  - ...That's it. That's the one. Look at the teeth on it.
  - Five hundred, as promised. Spend it somewhere far from the water.
  bountyRefuseSaleLine: That's the bounty fish. Don't sell it by the pound like a
    truttle -- turn it in and I'll pay the bounty.
  bountyReward: 500
  bountyTurnedInFlag: grulabu_turned_in
