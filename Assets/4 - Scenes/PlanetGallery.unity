TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 896814928}
  m_Text: "PLANET GALLERY\nPlay \u2192 WASD / Q E fly, Shift = fast, wheel = speed
    (5 \u2026 12,000 m/s), Esc frees the mouse\nLeft\u2192right: Icey Twin \xB7 Fiery
    Twin \xB7 Humble Abode \xB7 Cyclops \xB7 then 10 dwarf planets\nTweak a dwarf:
    its Shape / Shading / Atmosphere assets live in Solar System/Dwarf Planets/<name>\nSee
    terrain WITHOUT pressing Play: Tools \u25B8 Planet Preview \u25B8 Show All Bodies
    (then Clear)\nRebuild: Tools \u25B8 Planet Gallery \u25B8 Build Scene (keeps
    your dwarf tweaks)"
  m_OffsetZ: 0
  m_CharacterSize: 2.2
